rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      // כל משתמש שמחובר עם Google יכול להגיש דרישה חדשה (הטופס הציבורי מחייב התחברות),
      // בכפוף לשדות חובה בסיסיים, וש-submitterEmail תואם את המשתמש המחובר בפועל.
      allow create: if request.auth != null
        && request.resource.data.submitterEmail == request.auth.token.email
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.submitterName is string
        && request.resource.data.submitterName.size() > 0
        && request.resource.data.courseDate is string
        && request.resource.data.courseDate.size() > 0;

      // קריאה: מנהלים רואים הכל (עמוד /admin.html), וכל משתמש מחובר יכול לקרוא גם את
      // ההגשות שהוא עצמו הגיש (נדרש לכפתור "שכפל את ההגשה האחרונה שלי" בטופס הציבורי).
      allow read: if request.auth != null
        && (
          request.auth.token.email.lower() in [
            "nohar.tzur@gmail.com",
            "yonatan1279@gmail.com"
          ]
          || resource.data.submitterEmail == request.auth.token.email
        );

      // עדכון ומחיקה מותרים רק למנהלים המורשים.
      allow update, delete: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /feedback/{feedbackId} {
      // כל משתמש מחובר יכול לדווח על באג/הצעת שיפור מהטופס הציבורי.
      allow create: if request.auth != null
        && request.resource.data.submitterEmail == request.auth.token.email
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;

      // קריאה ומחיקה מותרות רק למנהלים המורשים.
      allow read, delete: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /dailyNotes/{date} {
      // תוכן ידני (רכבים/כוח אדם/כיתות וכו') לדוח הבוקר לפי תאריך - קריאה וכתיבה רק למנהלים.
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /pushSubscriptions/{subId} {
      // כל משתמש מחובר יכול לרשום מנוי push לעצמו (הפעלת התראות בטופס/בניהול).
      allow create: if request.auth != null
        && request.resource.data.userEmail == request.auth.token.email;

      // קריאה: רק מנהלים (נדרש לסקריפטים המתוזמנים). מחיקה: המשתמש יכול לבטל מנוי משלו,
      // וגם מנהלים - וכן הסקריפטים המתוזמנים (Service Account, עוקף rules) מנקים מנויים שפגו.
      allow read: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
      allow delete: if request.auth != null
        && (
          request.auth.token.email.lower() in [
            "nohar.tzur@gmail.com",
            "yonatan1279@gmail.com"
          ]
          || resource.data.userEmail == request.auth.token.email
        );
    }
  }
}
