rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      // כל משתמש שמחובר עם Google יכול להגיש דרישה חדשה (הטופס הציבורי מחייב התחברות),
      // בכפוף לשדות חובה בסיסיים, וש-submitterEmail תואם את המשתמש המחובר בפועל (.lower()
      // משני הצדדים - כתובת Gmail לא תלוית-רישיות, וכתובת שנשמרה פעם ברישיות שונה מהטוקן
      // הנוכחי לא אמורה לחסום פעולות על ההגשה של אותו משתמש עצמו).
      allow create: if request.auth != null
        && request.resource.data.submitterEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.submitterName is string
        && request.resource.data.submitterName.size() > 0
        && request.resource.data.courseDate is string
        && request.resource.data.courseDate.size() > 0;

      // קריאה: מנהלים רואים הכל (עמוד /admin.html), וכל משתמש מחובר יכול לקרוא גם את
      // ההגשות שהוא עצמו הגיש (נדרש לכפתור "שכפל את ההגשה האחרונה שלי" בטופס הציבורי).
      allow read: if request.auth != null
        && (
          request.auth.token.email.lower() in [
            "nohar.tzur@gmail.com",
            "yonatan1279@gmail.com"
          ]
          || resource.data.submitterEmail.lower() == request.auth.token.email.lower()
        );

      // עדכון: מנהלים יכולים לעדכן כל הגשה. משתמש רגיל יכול לערוך רק הגשה שהוא עצמו הגיש
      // (submitterEmail לפני ואחרי העדכון חייב להישאר שלו - כדי שלא יוכל "לגנוב" הגשה של
      // מישהו אחר או להעביר הגשה שלו למישהו אחר), ובכפוף לאותם שדות חובה בסיסיים כמו ביצירה.
      // .lower() משני הצדדים כאן גם, מאותה סיבה כמו ב-create.
      allow update: if request.auth != null
        && (
          request.auth.token.email.lower() in [
            "nohar.tzur@gmail.com",
            "yonatan1279@gmail.com"
          ]
          || (
            resource.data.submitterEmail.lower() == request.auth.token.email.lower()
            && request.resource.data.submitterEmail.lower() == request.auth.token.email.lower()
            && request.resource.data.courseName is string
            && request.resource.data.courseName.size() > 0
            && request.resource.data.submitterName is string
            && request.resource.data.submitterName.size() > 0
            && request.resource.data.courseDate is string
            && request.resource.data.courseDate.size() > 0
          )
        );

      // מחיקה מותרת רק למנהלים המורשים.
      allow delete: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /feedback/{feedbackId} {
      // כל משתמש מחובר יכול לדווח על באג/הצעת שיפור מהטופס הציבורי.
      allow create: if request.auth != null
        && request.resource.data.submitterEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;

      // קריאה ומחיקה מותרות רק למנהלים המורשים.
      allow read, delete: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /dailyNotes/{date} {
      // תוכן ידני (רכבים/כוח אדם/כיתות וכו') לדוח הבוקר לפי תאריך - קריאה וכתיבה רק למנהלים.
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
    }

    match /pushSubscriptions/{subId} {
      // כל משתמש מחובר יכול לרשום מנוי push לעצמו (הפעלת התראות בטופס/בניהול).
      allow create: if request.auth != null
        && request.resource.data.userEmail.lower() == request.auth.token.email.lower();

      // קריאה: רק מנהלים (נדרש לסקריפטים המתוזמנים). מחיקה: המשתמש יכול לבטל מנוי משלו,
      // וגם מנהלים - וכן הסקריפטים המתוזמנים (Service Account, עוקף rules) מנקים מנויים שפגו.
      allow read: if request.auth != null
        && request.auth.token.email.lower() in [
          "nohar.tzur@gmail.com",
          "yonatan1279@gmail.com"
        ];
      allow delete: if request.auth != null
        && (
          request.auth.token.email.lower() in [
            "nohar.tzur@gmail.com",
            "yonatan1279@gmail.com"
          ]
          || resource.data.userEmail.lower() == request.auth.token.email.lower()
        );
    }
  }
}
